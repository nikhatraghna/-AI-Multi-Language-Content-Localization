    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst nested = items[0].json.data;\n\nconst result = {};\n\nfor (const entry of nested) {\n  result.rowId = entry.rowNumber;\n  result[entry.targetLang] = entry.translatedText;\n}\n\nreturn [{ json: result }];"
      },
