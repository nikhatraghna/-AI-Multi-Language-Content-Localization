      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nlet translatedText = \"\";\n\nif (Array.isArray(response) && response[0]?.translation_text) {\n  // response came through as an array\n  translatedText = response[0].translation_text;\n} else if (response.translation_text) {\n  // response came through as a plain object (n8n auto-unwrapped it)\n  translatedText = response.translation_text;\n} else {\n  translatedText = \"TRANSLATION_ERROR\";\n}\n\nreturn [{\n  json: {\n    rowNumber: $('Build Language Payloads').item.json.rowNumber,\n    targetLang: $('Build Language Payloads').item.json.targetLang,\n    translatedText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
