    {
      "parameters": {
        "jsCode": "const sourceText = $json.sourceText.replace(/\\n/g, ' ').replace(/\\r/g, '');\nconst rowNumber = $json.rowId;\n\nconst targets = [\n  { lang: \"Urdu\", model: \"Helsinki-NLP/opus-mt-en-ur\" },\n  { lang: \"Arabic\", model: \"Helsinki-NLP/opus-mt-en-ar\" },\n  { lang: \"French\", model: \"Helsinki-NLP/opus-mt-en-fr\" }\n];\n\nreturn targets.map(t => ({\n  json: {\n    sourceText,\n    rowNumber,\n    targetLang: t.lang,\n    modelName: t.model\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
